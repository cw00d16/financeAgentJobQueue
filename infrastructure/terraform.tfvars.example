# Copy this to terraform.tfvars and fill in your values
# Never commit terraform.tfvars to git — add it to .gitignore

aws_region   = "us-east-2"
project_name = "finance-agent-job-queue"
environment  = "prod"

# Your GitHub repo in owner/name format
github_repo = "cw00d16/financeAgentJobQueue"

# Lambda config
lambda_memory_mb                = 256
extract_worker_timeout_seconds  = 30
research_worker_timeout_seconds = 300

# SQS redrive — capped retries before a job's message moves to its DLQ
extraction_max_receive_count = 3
research_max_receive_count   = 3

# Research agent guardrails — hard iteration cap + token budget, enforced
# in-memory inside the researchWorker invocation (see README's Guardrails
# section)
research_max_iterations   = 5
research_max_total_tokens = 100000

# DynamoDB billing — PAY_PER_REQUEST is cheapest for low traffic
dynamodb_billing_mode = "PAY_PER_REQUEST"

# Observability — where the error-rate, DLQ-depth, and daily-spend alarms
# notify. SNS sends a one-time confirmation link to this address after
# `terraform apply`.
alert_email                     = "you@example.com"
daily_spend_alert_threshold_usd = 2
